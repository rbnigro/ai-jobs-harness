# Required for Gemini evaluation
GEMINI_API_KEY=replace-with-your-key

# Comma-separated official RSS/Atom feeds
JOB_ENABLE_RSS=false
JOB_RSS_URLS=

# Comma-separated local .eml newsletter files
JOB_ENABLE_NEWSLETTER=false
JOB_NEWSLETTER_FILES=

# Comma-separated partner API endpoints returning a JSON list or {"jobs": [...]}
JOB_ENABLE_PARTNER_API=false
JOB_PARTNER_API_URLS=

# Crawler requires both an allowed domain and a URL on that domain.
# It also requires robots.txt to allow AIJobsHarness/1.0.
JOB_ENABLE_CRAWLER=false
JOB_CRAWLER_ALLOWED_DOMAINS=
JOB_CRAWLER_URLS=

# APIs de vagas integradas
JOB_ENABLE_REMOTEOK=false
JOB_ENABLE_REMOTIVE=false
JOB_ENABLE_ADZUNA=true
JOB_ENABLE_JOOBLE=false
JOB_SEARCH_QUERY=Engenheiro de IA
JOB_SEARCH_LOCATION=Brasil
JOB_MAX_RESULTS=10

# Adzuna: crie credenciais no portal de desenvolvedores da Adzuna
ADZUNA_APP_ID=replace-with-your-adzuna-app-id
ADZUNA_APP_KEY=replace-with-your-adzuna-app-key
ADZUNA_COUNTRY=br
ADZUNA_PAGE=1
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_SORT_BY=relevance
ADZUNA_MAX_DAYS_OLD=
ADZUNA_DISTANCE=
ADZUNA_CATEGORY=
ADZUNA_FULL_TIME=
ADZUNA_PART_TIME=
ADZUNA_PERMANENT=
ADZUNA_CONTRACT=

# Jooble: informe a chave recebida no programa de parceiros
JOOBLE_API_KEY=
JOOBLE_PAGE=1
